# ---------------------------------------------------------------------------
# MQDMS environment template
#
#   cp .env.example .env
#
# `.env` repoya commit edilmez. Bu dosya yalnızca değişken isimlerini ve
# beklenen formatı gösterir.
#
# Nerede kullanılır:
#   - Lokal geliştirme: `pnpm dev` (root `.env` → `apps/auth/.env` senkronlanır)
#   - Docker: `docker compose up` (compose `env_file: .env` ile okur)
#   - CI: GitHub Actions Secrets / Variables (aşağıdaki "GitHub" bölümüne bak)
# ---------------------------------------------------------------------------

# --- Uygulama ---------------------------------------------------------------

# local | staging | production
APP_ENV=local

# Uygulamanın public URL'i. NEXT_PUBLIC_* olduğu için client bundle'a
# build sırasında işlenir: GitHub'da bu değişken tanımlıysa CI image'ına
# gömülür, tanımlı değilse CI build'i başarısız olur.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Uygulama portu (sadece docker compose için)
APP_PORT=3000

# --- Veritabanı -------------------------------------------------------------

# Docker Compose bu değeri kendisi ezen servisler arasında
# `postgres:5432` olarak override eder.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mqdms

# --- Redis / Kuyruk ---------------------------------------------------------

REDIS_URL=redis://localhost:6379

# BullMQ queue prefix'i. Aynı Redis instance'ını paylaşan uygulamalar
# farklı prefix kullanmalı.
QUEUE_PREFIX=mqdms

# Worker'ın dinlediği queue'lar (virgülle ayrılmış)
WORKER_QUEUES=default,email

# --- Kimlik doğrulama -------------------------------------------------------

# En az 32 karakter. Üretimde openssl rand -base64 32 ile üret.
BETTER_AUTH_SECRET=

# Better Auth'in public URL'i. NEXT_PUBLIC_APP_URL ile aynı olmalı.
BETTER_AUTH_URL=http://localhost:3000

# --- E-posta ----------------------------------------------------------------

# Resend API key
RESEND_API_KEY=

# Gönderen e-posta adresi (Resend'de doğrulanmış olmalı)
RESEND_FROM_EMAIL=

# --- Depolama (S3 / R2 uyumlu) -----------------------------------------------

STORAGE_BUCKET=
STORAGE_REGION=auto

# S3 uyumlu servis için erişim bilgileri
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Opsiyonel: custom endpoint (R2 vb.). AWS S3 kullanılıyorsa boş bırakılabilir.
STORAGE_ENDPOINT=

# Opsiyonel: public URL prefix'i (CDN). Boş bırakılabilir.
STORAGE_PUBLIC_URL=

# --- Superadmin -------------------------------------------------------------

# Bootstrap akışı (ilk superadmin'i oluşturma) açık mı?
# Güvenlik için varsayılan kapalı: açmak için true yap ve aşağıya
# en az 32 karakterlik kendi anahtarını gir.
SUPERADMIN_BOOTSTRAP_ENABLED=false

# En az 32 karakter. Üretimde openssl rand -base64 32 ile üret.
# Boş bırakılırsa bootstrap kapalı kalır.
SUPERADMIN_BOOTSTRAP_KEY=

# --- OAuth provider (merkezi kimlik yöneticisi) ----------------------------

# Tüketen uygulamaların origin listesi (virgülle ayrılmış). better-auth bu
# listeye göre `callbackURL` yönlendirmelerini doğrular; tüketen uygulama
# adresleri buraya eklenir. Boş bırakılırsa yalnızca BETTER_AUTH_URL güvenilir.
OAUTH_TRUSTED_ORIGINS=

# Pairwise subject id üretimi için sır; en az 32 karakter olmalı.
# Boş bırakılırsa plugin'in varsayılanı kullanılır.
OAUTH_PAIRWISE_SECRET=

# Issuer URI'si. Boş bırakılırsa BETTER_AUTH_URL kullanılır.
OAUTH_ISSUER=
