# ---------------------------------------------------------------------------
# MQDMS environment template
#
#   cp .env.example .env
#
# `.env` repoya commit edilmez. Bu dosya yalnızca değişken isimlerini ve
# beklenen formatı gösterir.
#
# Nerede kullanılır:
#   - Lokal geliştirme: `pnpm dev` (root `.env` → `apps/*/.env` senkronlanır)
#   - Docker: `docker compose up` (compose `env_file: .env` ile okur)
#   - CI: GitHub Actions Secrets / Variables (aşağıdaki "GitHub" bölümüne bak)
#
# İki web deploy vardır ve ikisi aynı secret'ı ve aynı oturum cookie'sini
# paylaşır:
#
#   - auth.mqdms.com  → apps/auth  → NEXT_PUBLIC_APP_URL = auth adresi
#   - app.mqdms.com   → apps/app   → NEXT_PUBLIC_APP_URL = app adresi
#
# `NEXT_PUBLIC_AUTH_URL` her iki deploy'ta **aynı** olmalıdır.
# ---------------------------------------------------------------------------

# --- Uygulama ---------------------------------------------------------------

# local | staging | production
APP_ENV=local

# Deploy'un kendi public URL'i. NEXT_PUBLIC_* olduğu için client bundle'a
# build sırasında işlenir: GitHub'da bu değişken tanımlıysa CI image'ına
# gömülür. Tanımlı değilse CI build'i placeholder fallback'iyle devam eder;
# production'da client bundle'ın adresleri bildiğinden değişkenin GitHub'da
# tanımlı olması gerekir.
#
# auth deploy: https://auth.mqdms.com
# app deploy:  https://app.mqdms.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Kimlik doğrulama adresi. Her iki deploy'ta aynıdır; oturum cookie'si ve
# giriş yönlendirmeleri bu adrese gider.
NEXT_PUBLIC_AUTH_URL=http://localhost:3000

# İş uygulamasının adresi (app.mqdms.com). Auth panelinden iş uygulamasına
# bağlantı verilirken kullanılır.
NEXT_PUBLIC_BUSINESS_APP_URL=http://localhost:3001

# Uygulama portu (sadece docker compose için)
APP_PORT=3000

# İş uygulamasının portu (sadece docker compose için)
BUSINESS_APP_PORT=3001

# --- Veritabanı -------------------------------------------------------------

# Docker Compose bu değeri kendisi ezen servisler arasında
# `postgres:5432` olarak override eder.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mqdms

# --- Redis / Kuyruk ---------------------------------------------------------

REDIS_URL=redis://localhost:6379

# BullMQ queue prefix'i. Aynı Redis instance'ını paylaşan uygulamalar
# farklı prefix kullanmalı.
QUEUE_PREFIX=mqdms

# Worker'ın dinlediği queue'lar (virgülle ayrılmış)
WORKER_QUEUES=default,email

# --- Kimlik doğrulama -------------------------------------------------------

# En az 32 karakter. Üretimde openssl rand -base64 32 ile üret.
# İki deploy'ta **aynı** olmalıdır; farklı secret oturumları paylaşmaz.
BETTER_AUTH_SECRET=

# Better Auth'in public URL'i. Her iki deploy'ta aynıdır.
BETTER_AUTH_URL=http://localhost:3000

# better-auth'in güvenilir origin listesi (virgülle ayrılmış). Kesin
# listedir; wildcard kullanılmaz. `BETTER_AUTH_URL` her zaman listeye eklenir.
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Paylaşımlı oturum cookie'sinin alan adı.
#
# Üretimde `.mqdms.com` olmalıdır: cookie `auth.mqdms.com` tarafından
# yazılır ve `app.mqdms.com` tarafından okunur. Boş bırakılırsa cookie
# host'a özel yazılır (lokal geliştirme için uygundur; iki subdomain oturumu
# paylaşamaz).
AUTH_COOKIE_DOMAIN=

# --- E-posta ----------------------------------------------------------------

# Resend API key
RESEND_API_KEY=

# Gönderen e-posta adresi (Resend'de doğrulanmış olmalı)
RESEND_FROM_EMAIL=

# --- Depolama (S3 / R2 uyumlu) -----------------------------------------------

STORAGE_BUCKET=
STORAGE_REGION=auto

# S3 uyumlu servis için erişim bilgileri
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Opsiyonel: custom endpoint (R2 vb.). AWS S3 kullanılıyorsa boş bırakılabilir.
STORAGE_ENDPOINT=

# Opsiyonel: public URL prefix'i (CDN). Boş bırakılabilir.
STORAGE_PUBLIC_URL=

# --- İlk kurulum (bootstrap) ------------------------------------------------

# İlk organizasyonu ve owner hesabını oluşturan akış açık mı?
# Güvenlik için varsayılan kapalı: açmak için true yap ve aşağıya
# en az 32 karakterlik kendi anahtarını gir.
ORG_BOOTSTRAP_ENABLED=false

# En az 32 karakter. Üretimde openssl rand -base64 32 ile üret.
# Boş bırakılırsa bootstrap kapalı kalır.
ORG_BOOTSTRAP_KEY=
